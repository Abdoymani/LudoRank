<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer. Same rules as backup_rules.xml:
     keep ludorank.db, leave out its WAL/SHM side files. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/ludorank.db-wal" />
        <exclude domain="root" path="app_flutter/ludorank.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/ludorank.db-wal" />
        <exclude domain="root" path="app_flutter/ludorank.db-shm" />
    </device-transfer>
</data-extraction-rules>
